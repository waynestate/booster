{
    "main": "bin/booster",
    "output": "build/booster.phar",
    "compression": "GZ",
    "check-requirements": true,
    "files": [
        "config/rector.php",
        "data/behaviour-changes.json",
        "data/removals.json",
        "data/versions.json",
        "docker/Dockerfile",
        "docker/cakephp-upgrade/Dockerfile",
        "docker/cakephp-upgrade/app-autoload.php",
        "resources/policy.schema.json",
        "resources/replay/client.php",
        "resources/replay/router.php",
        "resources/sesame/config/sesame.php",
        "resources/sesame/ReadOnlyAttributes.php",
        "resources/strangler-signin/cake/config/sesame.php",
        "resources/strangler-signin/cake/src/Sesame/LegacySignIn.php",
        "resources/strangler-signin/cake/src/Sesame/TicketMiddleware.php",
        "resources/strangler-signin/cake/src/Sesame/UserResolver.php",
        "resources/strangler-signin/laravel/app/Sesame/StranglerUser.php",
        "resources/strangler-signin/laravel/app/Sesame/StranglerUserResolver.php",
        "resources/strangler-signin/slim/Sesame/LegacySignIn.php",
        "resources/slim1/slim1-bridge.php",
        "resources/strangler/dispatcher.php",
        "resources/strangler/install-legacy.php",
        "resources/strangler/public.htaccess",
        "resources/strangler/slim/CapturingEmitter.php",
        "resources/strangler/slim/LegacyClosure.php",
        "resources/strangler/slim/LegacyContainer.php",
        "resources/strangler/slim/LegacyResponse.php",
        "resources/strangler/slim/LegacyServiceProvider.php",
        "resources/strangler/slim/SlimAdapter.php",
        "vendor/bin/phpcs",
        "vendor/bin/phpstan",
        "vendor/waynestate/creed/policy/policy.json"
    ]
}
