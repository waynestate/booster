# Booster reads these environment variables. Everything else is a command-line option.
# Path to CREED's policy.json. Leave it unset to use the policy.json in the waynestate/creed package.
BOOSTER_POLICY=
# Opt-in Composer download cache for the gate: a Docker volume name (the stack uses stack-composer-cache) or a host
# folder. Leave it unset and every gate container downloads every package again, as before.
BOOSTER_COMPOSER_CACHE=
