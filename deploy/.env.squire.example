# .env.squire.example: settings for Squire's local parity setup and release scripts. Copy it to .env.squire (which is
# gitignored) and fill in the secrets. Nothing here is a real credential.

# --- local parity (docker-compose.squire.yml) ---------------------------------------------------------------------
# Compose project name; also the local image tag.
SQUIRE_PROJECT=squire-app
# The app image. citadel/php-apache:8.4r5 is the real Citadel image, built with Citadel's `php citadel build_images`
# or pulled from the registry you keep it in. Pin it by digest once you have one (S67):
#   SQUIRE_BASE_IMAGE=citadel/php-apache:8.4r5@sha256:REPLACE_WITH_THE_DIGEST_OF_YOUR_BUILD
# With no access to the real image, run `scripts/parity.sh up --fallback`, which builds an approximation.
SQUIRE_BASE_IMAGE=citadel/php-apache:8.4r5
# Pins for the proxy and database. The compose file already carries digests; override only to bump them on purpose.
#   SQUIRE_PROXY_IMAGE=haproxy:3.0-alpine@sha256:...
#   SQUIRE_MYSQL_IMAGE=mysql:5.6.51@sha256:...
# The document root inside the container, relative to /citadel (Citadel passes the dashboard's public path).
SQUIRE_PUBLIC_DIR=src/public
SQUIRE_SERVER_NAME=app.apps.wayne.test
SQUIRE_TZ=America/Detroit
SQUIRE_ENVIRONMENT=local
SQUIRE_DEPLOYMENTS=./deployments/
# Where you reach the app: http://127.0.0.1:8080 (through the proxy).
SQUIRE_HTTP_PORT=8080
SQUIRE_APP_MEMORY=512m
# Used only by the fallback base image, to match your user id on Linux.
SQUIRE_SOURCE_UID=1000
SQUIRE_SOURCE_GID=1000

# --- database: MySQL 5.6.51, reachable from the app as host `mysql` -----------------------------------------------
SQUIRE_DB_NAME=app
SQUIRE_DB_USER=app
SQUIRE_DB_PASSWORD=change-me-local-only
SQUIRE_DB_ROOT_PASSWORD=change-me-local-only-root
SQUIRE_DB_PORT=3307
SQUIRE_DB_MEMORY=512m

# --- release script (scripts/release.sh); every variable is optional --------------------------------------------
# On Citadel add this file as a configuration file named ./.env.squire (the configuration-files step after the wizard;
# the wizard has no environment field) and keep it out of git. release.sh reads only the options listed here.
# SQUIRE_FRAMEWORK=auto
# SQUIRE_COMPOSER_AUDIT=report
# SQUIRE_NPM=auto
# SQUIRE_NPM_IGNORE_SCRIPTS=1
# SQUIRE_MIGRATE=1
# SQUIRE_PROCTOR=auto
# SQUIRE_PROCTOR_POLICY=/path/to/policy.json
# SQUIRE_SMOKE=1
